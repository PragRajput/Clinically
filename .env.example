# --- Clinically configuration ---
# Copy to .env.local and adjust:  cp .env.example .env.local

# MongoDB connection string.
# Leave unset to use the zero-setup EMBEDDED MongoDB (mongodb-memory-server),
# which stores data in ./.mongo-data — fine for local development only.
#   Local Docker (see docker-compose.yml):  mongodb://localhost:27017/clinically
#   MongoDB Atlas:                          mongodb+srv://<user>:<pass>@<cluster>/clinically
# MONGODB_URI=mongodb://localhost:27017/clinically

# Secret used to sign session tokens.
# Optional in development; REQUIRED in production (min. 32 characters).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Demo mode: seed demo accounts + sample data when the DB is empty and list the
# demo logins on the sign-in page. Defaults to on in development, off in
# production. Set "true" only for a public demo deployment.
# AUTO_SEED=false

# First admin for a fresh production database (used only when demo mode is off
# and the DB has no users). Remove these after your first login.
# ADMIN_EMAIL=you@yourclinic.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# Currency symbol shown across the UI.
NEXT_PUBLIC_CURRENCY=₹

# Clinic name shown in the UI.
NEXT_PUBLIC_CLINIC_NAME=Clinically
